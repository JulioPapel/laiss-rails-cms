{
  "name": "laiss_cms_admin",
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "lint": "prettier --check 'app/javascript/**/*.js'",
    "eslint": "eslint app/javascript/**/*.js",
    "build:js": "rollup -c",
    "build:admin": "rollup -c rollup.admin.config.mjs",
    "build:admin:dev": "rollup -c rollup.admin.config.mjs --watch",
    "build:icons": "node bundles/remixicon.mjs",
    "build:css": "sass --style=compressed --no-source-map --quiet-deps --load-path app/assets/stylesheets --load-path vendor/assets/stylesheets --load-path node_modules/cropperjs/dist --load-path node_modules/tom-select/dist/scss app/stylesheets/laiss_cms/admin.scss:app/assets/builds/laiss_cms/admin.css app/stylesheets/laiss_cms/admin/print.scss:app/assets/builds/laiss_cms/admin/print.css app/stylesheets/laiss_cms/welcome.scss:app/assets/builds/laiss_cms/welcome.css app/stylesheets/laiss_cms/body-copy.scss:app/assets/builds/laiss_cms/body-copy.css app/stylesheets/tinymce/skins/content/laiss_cms/content.scss:app/assets/builds/tinymce/skins/content/laiss_cms/content.min.css app/stylesheets/tinymce/skins/content/laiss-cms-dark/content.scss:app/assets/builds/tinymce/skins/content/laiss-cms-dark/content.min.css app/stylesheets/tinymce/skins/ui/laiss-cms-dark/content.scss:app/assets/builds/tinymce/skins/ui/laiss-cms-dark/content.min.css app/stylesheets/tinymce/skins/ui/laiss_cms/content.scss:app/assets/builds/tinymce/skins/ui/laiss_cms/content.min.css app/stylesheets/tinymce/skins/ui/laiss_cms/skin.scss:app/assets/builds/tinymce/skins/ui/laiss_cms/skin.min.css app/stylesheets/tinymce/skins/ui/laiss-cms-dark/skin.scss:app/assets/builds/tinymce/skins/ui/laiss-cms-dark/skin.min.css app/stylesheets/laiss_cms/admin/remote-select.scss:app/assets/builds/laiss_cms/admin/remote-select.css app/stylesheets/laiss_cms/admin/page-select.scss:app/assets/builds/laiss_cms/admin/page-select.css app/stylesheets/laiss_cms/admin/tags-autocomplete.scss:app/assets/builds/laiss_cms/admin/tags-autocomplete.css app/stylesheets/laiss_cms/theme.scss:app/assets/builds/laiss_cms/theme.css devise/app/assets/stylesheets/laiss-cms-devise.scss:devise/app/assets/builds/laiss-cms-devise.css",
    "build": "pnpm run build:js && pnpm run build:admin && pnpm run build:css && pnpm run build:icons"
  },
  "keywords": [],
  "author": "Thomas von Deyen",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "@ungap/custom-elements": "^1.3.0",
    "clipboard": "^2.0.11",
    "cropperjs": "^1.7.0",
    "flatpickr": "^4.6.13",
    "keymaster": "^1.6.2",
    "sortablejs": "^1.15.7",
    "tinymce": "^8.10.0",
    "tom-select": "^2.6.2"
  },
  "devDependencies": {
    "@herb-tools/linter": "^0.11.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "consola": "^3.4.2",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "jsdom-testing-mocks": "^1.16.0",
    "prettier": "^3.9.10",
    "remixicon": "^4.9.1",
    "rollup": "^4.65.0",
    "sass": "^1.106.1",
    "svg-sprite": "^2.0.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
