<div class="widget-body">
  <header>
    <%= LaissCms.t('Who else is online') %>
    <aside><%= online_users&.count %></aside>
  </header>
  <% if online_users.blank? %>
    <laiss-cms-message type="info">
      <%= LaissCms.t('no users') %>
    </laiss-cms-message>
  <% else %>
    <table class="list">
    <% online_users.each do |user| %>
      <tr>
        <td class="name"><%= user.name %></td>
        <td class="right">
          <small><%= user.human_laiss_cms_roles %></small>
        </td>
      </tr>
    <% end %>
    </table>
  <% end %>
</div>
