<laiss-cms-publish-element-button id="publish-element-button-<%= element.id %>">
  <sl-button-group label="Example Button Group">
    <sl-tooltip
      content="<%= element.public? ? LaissCms.t(:hide_element) : LaissCms.t(:show_element) %>"
      <% if element.scheduled? || cannot?(:update, element) %>
        disabled
      <% end %>
    >
      <%= form_tag(laiss_cms.publish_admin_element_path(element), method: "patch") do %>
        <sl-button
          variant="<%= element.public? ? "default" : "primary" %>"
          type="submit"
          size="small"
          <% if element.scheduled? || cannot?(:update, element) %>
            disabled
          <% end %>
          outline
          pill
        >
          <laiss-cms-icon name="cloud-off" slot="prefix" size="1x"></laiss-cms-icon>
        </sl-button>
      <% end %>
    </sl-tooltip>
    <sl-tooltip
      content="<%= element.scheduled? ? LaissCms.t(:edit_element_schedule) : LaissCms.t(:schedule_element) %>"
      <% if cannot?(:update, element) %>
        disabled
      <% end %>
    >
      <sl-dropdown distance="5">
        <sl-button
          slot="trigger"
          variant="<%= element.scheduled? ? "primary" : "default" %>"
          size="small"
          <% if cannot?(:update, element) %>
          disabled
          <% end %>
          outline
          pill
        >
          <laiss-cms-icon name="calendar-schedule" slot="suffix" size="1x"></laiss-cms-icon>
        </sl-button>
        <div class="laiss-cms-popover">
          <%= render "laiss_cms/admin/elements/schedule", element: element %>
        </div>
      </sl-dropdown>
    </sl-tooltip>
  </sl-button-group>
</laiss-cms-publish-element-button>
