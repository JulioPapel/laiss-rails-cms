<%= content_for :toolbar do %>
  <%= render LaissCms::Admin::ToolbarButton.new(
    icon: 'angle-double-left',
    url: request.referer || laiss_cms.admin_dashboard_path,
    label: LaissCms.t(:back),
    title: LaissCms.t(:back),
    hotkey: 'alt+z',
    dialog: false,
    skip_permission_check: true
  ) %>
<% end %>

<% content_for(:laiss_cms_body_class) { 'error' } %>

<%= turbo_frame_tag request.headers["Turbo-Frame"] do %>
  <%= render_message(:error) do %>
    <h1><%= LaissCms.t('An error happened') %></h1>
    <h2>
      <%= @error.class %>
      <%= @notice %>
    </h2>
    <details>
      <summary><%= LaissCms.t('Show error details') %></summary>
      <% @trace.each do |line| %>
        <%= line %><br>
      <% end %>
    </details>
  <% end %>
<% end %>
