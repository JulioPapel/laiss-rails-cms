<% content_for(:toolbar) do %>
  <div class="toolbar_buttons">
    <% if can? :create, LaissCms::Attachment %>
      <div class="toolbar_button">
        <%= render LaissCms::Admin::UploaderButton.new(
          redirect_url: laiss_cms.admin_attachments_path(q: {
            last_upload: true
          }),
          object: LaissCms::Attachment.new,
          file_attribute: 'file',
          inline_label: true
        ) %>
      </div>
    <% end %>
  </div>

  <%= render 'laiss_cms/admin/partials/search_form' %>
<% end %>

<% if LaissCms::Attachment.none? %>
  <%= render 'laiss_cms/admin/resources/empty_state' do %>
    <%= render LaissCms::Admin::UploaderButton.new(
      redirect_url: laiss_cms.admin_attachments_path(q: {
        last_upload: true
      }),
      object: LaissCms::Attachment.new,
      file_attribute: 'file',
      inline_label: true
    ) %>
  <% end %>
<% else %>
  <%= render "laiss_cms/admin/resources/table_header" %>

  <% if @attachments.none? && search_filter_params.present? %>
    <%= render_message do %>
      <%= LaissCms.t(:no_search_results) %>
    <% end %>
  <% else %>
    <div class="resources-table-wrapper">
      <%= render "files_list" %>
    </div>
  <% end %>

  <%= render "laiss_cms/admin/resources/pagination", resources: @attachments %>
<% end %>

<%= render "library_sidebar" %>
