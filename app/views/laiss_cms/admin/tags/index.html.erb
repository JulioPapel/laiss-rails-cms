<% content_for :toolbar do %>
  <div class="toolbar_buttons">
    <%= render LaissCms::Admin::ToolbarButton.new(
      icon: :plus,
      label: LaissCms.t('New Tag'),
      primary: true,
      url: laiss_cms.new_admin_tag_path,
      hotkey: 'alt+n',
      tooltip_placement: "top-start",
      dialog_options: {
        title: LaissCms.t('New Tag'),
        size: '310x180'
      },
      if_permitted_to: [:create, LaissCms::Tag]
    ) %>
  </div>
  <%= render 'laiss_cms/admin/partials/search_form' %>
<% end %>

<% if LaissCms::Tag.any? %>
  <%= render 'laiss_cms/admin/resources/table_header' %>

  <% if @tags.any? %>
    <div class="resources-table-wrapper">
      <%= render LaissCms::Admin::Resource::Table.new(@tags, query: @query, search_filter_params: search_filter_params) do |table| %>
        <% table.icon_column "tag" %>
        <% table.column :name, sortable: true %>
        <% table.column :taggings_types do |tag| %>
          <% tag.taggings.collect(&:taggable).compact.uniq(&:class).each do |taggable| %>
            <span class="label">
              <%= taggable.class.model_name.human %>
            </span>
          <% end %>
        <% end %>
        <% table.column :taggings_count, sortable: true, class_name: "count" %>

        <% table.delete_button tooltip: LaissCms.t(:delete_tag), confirm_message: LaissCms.t(:do_you_really_want_to_delete_this_tag?) %>
        <% table.edit_button tooltip: LaissCms.t(:edit_tag), dialog_size: "360x410" %>
      <% end %>
    </div>

    <%= render "laiss_cms/admin/resources/pagination", resources: @tags %>
  <% elsif search_filter_params.present? %>
    <%= render_message do %>
      <%= LaissCms.t('No Tags found') %>
    <% end %>
  <% end %>
<% else %>
  <%= render "laiss_cms/admin/resources/empty_state" do %>
    <%= render_message do %>
      <%= LaissCms.t(:tags_get_created_if_used_the_first_time) %>
    <% end %>
  <% end %>
<% end %>
