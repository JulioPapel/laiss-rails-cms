<laiss-cms-menu-node node-id="<%= node.id %>" <%= "folded" if node.folded? %>>
  <%= content_tag :li, class: 'menu-item', data: { id: node.id, parent_id: node.parent_id } do %>
    <%= content_tag :div, class: [
      'sitemap_node',
      node.external? ? 'external' : 'internal',
      "sitemap_node-level_#{node.depth}"
    ] do %>
      <span class="nodes_tree-left_images">
        <laiss-cms-node-folder
          <%= "folded" if node.folded? %>
          <%= "hidden" unless node.children.any? || node.folded? %>
        ></laiss-cms-node-folder>
      </span>
      <div class="node_name">
        <%= node.name || '&nbsp;'.html_safe %>
        <span class="node_page">
        <% if node.page %>
          <%= render_icon "file-3" %>
          <%= link_to [:edit, :admin, node.page], title: LaissCms.t(:edit_page) do %>
            <%= node.page.name %>
          <% end %>
        <% end %>
        </span>
        <% if node.url %>
          <span class="node_url">
            <%= link_to node.url, node.url, target: '_blank', title: node.url %>
            <% if node.external? %>
              <%= render_icon "external-link", size: "sm" %>
            <% end %>
          </span>
        <% end %>
      </div>
      <span class="nodes_tree-right_tools">
        <% if can?(:edit, node) %>
          <sl-tooltip content="<%= node.root? ? LaissCms.t(:edit_menu) : LaissCms.t(:edit_node) %>">
            <%= link_to_dialog(
              render_icon(:edit),
              laiss_cms.edit_admin_node_path(node),
              {
                title: node.root? ? LaissCms.t(:edit_menu) : LaissCms.t(:edit_node),
                size: node.root? ? '450x120' : '450x360'
              },
              class: "icon_button"
            ) %>
          </sl-tooltip>
        <% end %>
        <% if can?(:copy, node) %>
        <sl-tooltip content="<%= LaissCms.t(:copy_node) %>">
          <%= link_to(
            render_icon("file-copy"),
            laiss_cms.insert_admin_clipboard_path(
              remarkable_type: :nodes,
              remarkable_id: node.id,
            ),
            "data-turbo-method": :post,
            class: "icon_button"
          ) %>
        </sl-tooltip>
        <% else %>
        <div class="sitemap_tool disabled">
          <sl-tooltip content="<%= LaissCms.t("Your user role does not allow you to copy this node") %>" class="like-hint-tooltip" placement="bottom-start">
            <%= render_icon("file-copy") %>
          </sl-tooltip>
        </div>
        <% end %>
        <% if can?(:destroy, node) %>
          <sl-tooltip content="<%= node.root? ? LaissCms.t(:delete_menu) : LaissCms.t(:delete_node) %>">
            <%= link_to_confirm_dialog(
              render_icon("delete-bin-2"),
              node.root? ? LaissCms.t(:confirm_to_delete_menu) : LaissCms.t(:confirm_to_delete_node),
              url_for(
                controller: 'nodes',
                action: 'destroy',
                id: node.id
              ),
              {
                class: "icon_button"
              },
            ) %>
          </sl-tooltip>
        <% end %>
        <% if can?(:create, LaissCms::Node) %>
          <sl-tooltip content="<%= LaissCms.t(:create_node) %>" placement="top-end">
            <%= link_to_dialog(
              render_icon(:add),
              laiss_cms.new_admin_node_path(parent_id: node.id),
              {
                title: LaissCms.t(:create_node),
                size: '450x360',
                overflow: true
              },
              class: "icon_button"
            ) %>
          </sl-tooltip>
        <% end %>
      </span>
    <% end %>
    <%= content_tag :ul, class: "children #{' folded' if node.folded?}", data: { record_id: node.id } do %>
      <%= render partial: 'node', collection: node.children.includes(:page, :children) %>
    <% end %>
  <% end %>
</laiss-cms-menu-node>
