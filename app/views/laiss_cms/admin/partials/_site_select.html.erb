<%- if multi_site? -%>
<div class="toolbar_button">
  <sl-tooltip content="<%= LaissCms.t("Current site") %>">
    <%= form_tag url_for, method: :get do %>
      <laiss-cms-auto-submit>
        <%= select_tag :site_id,
          options_for_select(sites_for_select, LaissCms::Current.site.id) %>
      </laiss-cms-auto-submit>
    <% end %>
  </sl-tooltip>
</div>
<div class="toolbar_spacer"></div>
<%- end -%>
