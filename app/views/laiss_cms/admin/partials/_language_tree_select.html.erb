<% languages = LaissCms::Language.on_current_site %>
<% if can?(:switch_language, LaissCms::Page) && languages.many? %>
<div class="toolbar_button">
  <sl-tooltip content="<%= LaissCms.t("Language tree") %>">
    <%= form_tag switch_admin_languages_path do %>
      <laiss-cms-auto-submit>
        <%= select_tag(
          :language_id,
          options_for_select(
            languages.map { |l| [l.name, l.id] },
            LaissCms::Current.language.id
          ),
          class: "short"
        ) %>
      </laiss-cms-auto-submit>
    <% end %>
  </sl-tooltip>
</div>
<div class="toolbar_spacer"></div>
<% end %>
