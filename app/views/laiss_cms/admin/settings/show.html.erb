<% content_for :title, LaissCms.t("settings.title") %>

<%# Settings, adopting the theme's form-card structure verbatim.
    Source: theme/form-element.html — .card > .card-header > h4.card-title,
    then .card-body > .basic-form > form > .form-group > label + .form-control.
    Only the data and the fields are ours; the element structure is the theme's. %>

<div class="container-fluid">
  <div class="row">
    <div class="col-lg-12">
      <div class="card">
        <div class="card-header">
          <h4 class="card-title"><%= LaissCms.t("settings.title") %></h4>
          <p class="text-muted m-b-0 f-s-12"><%= LaissCms.t("settings.description") %></p>
        </div>
      </div>

      <% if @errors.any? %>
        <div class="alert alert-danger" role="alert">
          <strong><%= LaissCms.t("settings.errors.heading") %></strong>
          <ul class="m-b-0">
            <% @errors.each do |key, message| %>
              <li><%= LaissCms::Admin::Settings.find(key)&.key || key %>: <%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: laiss_cms.admin_settings_path, method: :patch,
        class: "settings-form", scope: :settings, local: true do |form| %>

        <% @sections.each do |section| %>
          <% fields = LaissCms::Admin::Settings.fields_for(section).select { |field| field.section == section } %>
          <% next if fields.empty? %>

          <div class="card settings-section" aria-labelledby="settings-section-<%= section %>">
            <div class="card-header">
              <h4 class="card-title"><%= LaissCms.t("settings.sections.#{section}") %></h4>
              <% if section == :read_only %>
                <p class="text-muted m-b-0 f-s-12"><%= LaissCms.t("settings.read_only_hint") %></p>
              <% end %>
            </div>
            <div class="card-body">
              <div class="basic-form">
                <% fields.each do |field| %>
                  <% id = "settings_#{field.key.tr('.', '_')}" %>
                  <% value = @values[field.key] %>
                  <% read_only = field.restart? %>

                  <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="<%= id %>">
                      <%= LaissCms.t("settings.fields.#{field.key.tr(".", "_")}") %>
                    </label>
                    <div class="col-sm-7">
                      <% if read_only %>
                        <output class="form-control-plaintext" id="<%= id %>">
                          <%= value.presence || LaissCms.t("settings.none") %>
                        </output>
                      <% elsif field.type == :boolean %>
                        <div class="custom-control custom-switch">
                          <%= hidden_field_tag "settings[#{field.key}]", "0", id: nil %>
                          <%= check_box_tag "settings[#{field.key}]", "1",
                            ActiveModel::Type::Boolean.new.cast(value),
                            id: id, class: "custom-control-input" %>
                          <label class="custom-control-label" for="<%= id %>"></label>
                        </div>
                      <% elsif field.type == :select %>
                        <%= select_tag "settings[#{field.key}]",
                          options_for_select(select_choices(field), value.to_s),
                          id: id, class: "form-control" %>
                      <% elsif field.type == :integer %>
                        <%= number_field_tag "settings[#{field.key}]", value, id: id,
                          min: field.min, max: field.max, step: 1, class: "form-control" %>
                      <% else %>
                        <%= text_field_tag "settings[#{field.key}]", value, id: id, class: "form-control" %>
                      <% end %>

                      <p class="text-muted m-b-0 f-s-12">
                        <%= LaissCms.t("settings.fields.#{field.key.tr(".", "_")}_hint") %>
                      </p>
                    </div>
                    <div class="col-sm-2 text-right">
                      <span class="badge badge-<%= read_only ? "secondary" : "success" %>">
                        <%= LaissCms.t(read_only ? "settings.restart" : "settings.runtime") %>
                      </span>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="card">
          <div class="card-body text-right">
            <%= form.submit LaissCms.t(:save), class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
