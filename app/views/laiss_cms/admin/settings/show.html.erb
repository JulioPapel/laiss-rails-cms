<% content_for :title, LaissCms.t("settings.title") %>

<div class="settings-page journal-section">
  <header class="settings-page__header">
    <h1 class="settings-page__title"><%= LaissCms.t("settings.title") %></h1>
    <p class="settings-page__lede"><%= LaissCms.t("settings.description") %></p>
  </header>

  <% if @errors.any? %>
    <div class="settings-page__errors" role="alert">
      <strong><%= LaissCms.t("settings.errors.heading") %></strong>
      <ul>
        <% @errors.each do |key, message| %>
          <li><%= LaissCms::Admin::Settings.find(key)&.key || key %>: <%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: laiss_cms.admin_settings_path, method: :patch, class: "settings-form", scope: :settings, local: true do |form| %>
    <% @sections.each do |section| %>
      <% fields = LaissCms::Admin::Settings.fields_for(section).select { |field| field.section == section } %>
      <% next if fields.empty? %>

      <section class="settings-section" aria-labelledby="settings-section-<%= section %>">
        <div class="settings-section__head">
          <h2 class="settings-section__title" id="settings-section-<%= section %>">
            <%= LaissCms.t("settings.sections.#{section}") %>
          </h2>
          <% if section == :read_only %>
            <p class="settings-section__note"><%= LaissCms.t("settings.read_only_hint") %></p>
          <% end %>
        </div>

        <div class="settings-section__fields">
          <% fields.each do |field| %>
            <% id = "settings_#{field.key.tr('.', '_')}" %>
            <% value = @values[field.key] %>
            <% read_only = field.restart? %>

            <div class="settings-field<%= " settings-field--read-only" if read_only %>">
              <div class="settings-field__label">
                <%= label_tag id, LaissCms.t("settings.fields.#{field.key.tr('.', '_')}", default: field.key.humanize) %>
              </div>

              <div class="settings-field__control">
                <% if read_only %>
                  <output class="settings-field__output" id="<%= id %>">
                    <%= value.presence || LaissCms.t("settings.none") %>
                  </output>
                <% elsif field.type == :boolean %>
                  <label class="settings-switch">
                    <%= hidden_field_tag "settings[#{field.key}]", "0", id: nil %>
                    <%= check_box_tag "settings[#{field.key}]", "1", ActiveModel::Type::Boolean.new.cast(value),
                      id: id, class: "settings-switch__input" %>
                    <span class="settings-switch__track" aria-hidden="true">
                      <span class="settings-switch__thumb"></span>
                    </span>
                  </label>
                <% elsif field.type == :select %>
                  <%= select_tag "settings[#{field.key}]",
                    options_for_select(select_choices(field), value.to_s),
                    id: id, class: "settings-input settings-input--select" %>
                <% elsif field.type == :integer %>
                  <%= number_field_tag "settings[#{field.key}]", value, id: id,
                    min: field.min, max: field.max, step: 1,
                    class: "settings-input settings-input--number" %>
                <% else %>
                  <%= text_field_tag "settings[#{field.key}]", value, id: id,
                    class: "settings-input" %>
                <% end %>

                <p class="settings-field__hint">
                  <%= LaissCms.t("settings.fields.#{field.key.tr('.', '_')}_hint", default: "") %>
                </p>
              </div>

              <div class="settings-field__effect">
                <span class="settings-badge settings-badge--<%= read_only ? "restart" : "runtime" %>">
                  <%= LaissCms.t(read_only ? "settings.restart" : "settings.runtime") %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <div class="settings-form__actions">
      <%= form.submit LaissCms.t(:save), class: "button primary" %>
    </div>
  <% end %>
</div>
