<%# Secondary widgets, two to a row as the theme does with its content cards.
    Source: theme/index.html — .row > .col-lg-4 / .col-xl-8 combinations. %>
<% if LaissCms.config.dashboard.widgets.any? %>
  <div class="row">
    <% LaissCms.config.dashboard.widgets.each do |widget, args| %>
      <div class="col-lg-6">
        <%= render widget.new(**args) %>
      </div>
    <% end %>
  </div>
<% end %>
