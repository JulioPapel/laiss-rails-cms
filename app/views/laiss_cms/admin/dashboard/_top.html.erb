<%# Greeting and system info, in the theme's two-column card row.
    Source: theme/index.html — .row > .col-xl-8 + .col-xl-4, each holding a .card. %>
<div class="row">
  <div class="col-xl-8 col-lg-8 col-md-8">
    <%= render LaissCms::Admin::Dashboard::Widgets::Greeting.new(user: current_laiss_cms_user) %>
  </div>
  <div class="col-xl-4 col-lg-4 col-md-4">
    <%= render LaissCms::Admin::Dashboard::Widgets::SystemInfo.new %>
  </div>
</div>
