<% if action_name == "edit" && @page == locked_page %>
  <%= render 'laiss_cms/admin/pages/current_page', current_page: @page %>
<% else %>
  <div class="locked_page wide" id="locked_page_<%= locked_page.id %>">
    <%= link_to laiss_cms.edit_admin_page_path(locked_page) do %>
      <%= render 'laiss_cms/admin/pages/page_infos', page: locked_page %>
    <% end %>
    <%= form_tag(laiss_cms.unlock_admin_page_path(locked_page)) do %>
      <button class="icon_button small" title="<%= LaissCms.t(:explain_unlocking) %>">
        <%= render_icon(:close, size: '1x') %>
      </button>
    <% end %>
  </div>
<% end %>
