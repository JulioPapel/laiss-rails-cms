<%= laiss_cms_form_for([:admin, @page]) do |f| %>
  <% if @page.parent_id || @page.layoutpage %>
    <%= f.hidden_field(:parent_id) %>
  <% else %>
    <% @page.parent = @current_language.root_page %>
    <%= render LaissCms::Admin::PageSelect.new(@page.parent) do %>
      <%= f.input :parent_id, as: :string %>
    <% end %>
  <% end %>
  <%= f.hidden_field(:language_id) %>
  <%= f.hidden_field(:layoutpage) %>
  <%= f.input :page_layout,
    collection: @page_layouts,
    label: LaissCms.t(:page_type),
    include_blank: @page_layouts.length == 1 ? nil : LaissCms.t('Please choose'),
    required: true,
    selected: @page_layouts.length == 1 ? @page_layouts.first : @page.page_layout,
    input_html: {is: 'laiss-cms-select'} %>
  <%= f.input :name %>
  <%= f.submit LaissCms.t(:create), class: "primary" %>
<% end %>
