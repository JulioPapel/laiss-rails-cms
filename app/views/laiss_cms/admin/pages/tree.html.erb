<%= turbo_frame_tag "laiss_cms_pages_tree" do %>
  <h4 id="sitemap_heading">
    <span class="page_name"><%= LaissCms::Page.human_attribute_name(:name) %></span>
    <span class="page_urlname"><%= LaissCms::Page.human_attribute_name(:urlname) %></span>
    <span class="page_status"><%= LaissCms.t(:page_status) %></span>
  </h4>

  <laiss-cms-sitemap>
    <ul id="sitemap" class="list">
      <%= render LaissCms::Admin::PageNode.new(page: @root_page) %>
    </ul>
  </laiss-cms-sitemap>
<% end %>
