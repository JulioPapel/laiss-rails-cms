<% content_for :toolbar do %>
<div class="toolbar_buttons">
  <%= render 'laiss_cms/admin/partials/site_select' %>
  <%= render 'laiss_cms/admin/partials/language_tree_select' %>
  <%= render LaissCms::Admin::ToolbarButton.new(
    icon: "add",
    url: laiss_cms.new_admin_page_path(language: @current_language, layoutpage: true),
    hotkey: 'alt+n',
    dialog_options: {
      title: LaissCms.t('Add global page'),
      size: '340x170',
      overflow: true
    },
    label: LaissCms.t('Add global page'),
    primary: true,
    tooltip_placement: "top-start",
    if_permitted_to: [:create, LaissCms::Page]
  ) %>
  <%= render "laiss_cms/admin/clipboard/button", remarkable_type: "pages" %>
</div>
<% end %>

<% if @layout_pages.any? %>
  <h4 id="sitemap_heading">
    <span class="page_name"><%= LaissCms::Page.human_attribute_name(:name) %></span>
  </h4>

  <ul class="list" id="layoutpages">
    <%= render partial: "layoutpage", collection: @layout_pages %>
  </ul>
<% else %>
  <%= render "laiss_cms/admin/resources/empty_state",
    notice: LaissCms.t(:layoutpages, scope: :no_resource_found) do %>
    <% if can?(:create, LaissCms::Page) %>
      <%= link_to_dialog(
        render_icon(:add) + LaissCms.t("Add global page"),
        laiss_cms.new_admin_page_path(language: @current_language, layoutpage: true),
        {
          title: LaissCms.t("Add global page"),
          size: "340x170",
          overflow: true
        },
        class: "button with_icon"
      ) %>
    <% end %>
  <% end %>
<% end %>
