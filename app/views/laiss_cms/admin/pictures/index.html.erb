<% content_for(:toolbar) do %>
  <div class="toolbar_buttons">
    <% if can? :create, LaissCms::Picture %>
      <div class="toolbar_button">
        <%= render LaissCms::Admin::UploaderButton.new(
          object: LaissCms::Picture.new,
          file_attribute: 'image_file',
          layout: 'card',
          redirect_url: laiss_cms.admin_pictures_path(
            size: @size,
            q: { last_upload: true }
          ),
          inline_label: true
        ) %>
      </div>
      <div class="toolbar_spacer"></div>
    <% end %>
    <div class="button_group">
      <sl-tooltip content="<%= LaissCms.t(:small_thumbnails) %>">
        <%= link_to(
          render_icon('zoom-out'),
          laiss_cms.admin_pictures_path(
            search_filter_params.merge(size: "small").to_h
          ),
          class: "icon_button"
        ) %>
      </sl-tooltip>
      <sl-tooltip content="<%= LaissCms.t(:medium_thumbnails) %>">
        <%= link_to(
          render_icon('search'),
          laiss_cms.admin_pictures_path(
            search_filter_params.merge(size: "medium").to_h
          ),
          class: "icon_button"
        ) %>
      </sl-tooltip>
      <sl-tooltip content="<%= LaissCms.t(:big_thumbnails) %>">
        <%= link_to(
          render_icon('zoom-in'),
          laiss_cms.admin_pictures_path(
            search_filter_params.merge(size: "large").to_h
          ),
          class: "icon_button"
        ) %>
      </sl-tooltip>
    </div>
    <div class="toolbar_spacer"></div>
    <div class="toolbar_button">
      <sl-tooltip content="<%= LaissCms.t("Select all") %>">
        <%= link_to(
          render_icon('checkbox-multiple'),
          nil,
          id: 'select_all_pictures',
          class: 'icon_button',
          'data-laiss-cms-hotkey' => 'alt+a'
        ) %>
      </sl-tooltip>
    </div>
  </div>

  <%= render 'laiss_cms/admin/partials/search_form',
    additional_params: [:size] %>
<% end %>

<laiss-cms-picture-archive>
  <% if LaissCms::Picture.none? %>
    <%= render 'laiss_cms/admin/resources/empty_state' do %>
      <%= render LaissCms::Admin::UploaderButton.new(
          object: LaissCms::Picture.new,
          file_attribute: 'image_file',
          redirect_url: laiss_cms.admin_pictures_path(
            size: @size,
            q: { last_upload: true }
          ),
          inline_label: true
        ) %>
    <% end %>
  <% else %>
    <div class="resources-header">
      <h2>
        <%= @pictures.total_count %>
        <%= LaissCms::Picture.model_name.human(count: @pictures.total_count) %>
      </h2>
      <%= render "laiss_cms/admin/resources/applied_filters" %>
    </div>

    <% if @pictures.none? && @recent_pictures.blank? && search_filter_params.present? %>
      <%= render_message do %>
        <%= LaissCms.t(:no_search_results) %>
      <% end %>
    <% else %>
      <%= render "archive" %>
    <% end %>

    <%= render "laiss_cms/admin/resources/pagination", resources: @pictures %>
  <% end %>
</laiss-cms-picture-archive>

<%= render "library_sidebar" %>
