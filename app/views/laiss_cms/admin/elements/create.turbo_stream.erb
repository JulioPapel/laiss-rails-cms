<% if @element.fixed? %>
  <% target = "fixed_element_#{@element.id}" %>
  <%= turbo_stream.append "fixed-elements",
    partial: "laiss_cms/admin/elements/fixed_element",
    locals: {element: @element} %>
<% elsif @element.parent_element %>
  <% target = "element_#{@element.parent_element_id}_nested_elements" %>
<% else %>
  <% target = "main-content-elements" %>
<% end %>

<%- if @cut_element_id -%>
  <%= turbo_stream.remove "element_#{@cut_element_id}" %>
<% end %>

<% if @insert_at_top %>
  <%= turbo_stream.prepend target do %>
    <%= render LaissCms::Admin::ElementEditor.new(element: @element, created: true) %>
  <% end %>
<% else %>
  <%= turbo_stream.append target do %>
    <%= render LaissCms::Admin::ElementEditor.new(element: @element, created: true) %>
  <% end %>
<% end %>

<%= turbo_stream.replace "clipboard_button",
  partial: "laiss_cms/admin/clipboard/button",
  locals: {remarkable_type: "elements"} %>

<%= turbo_stream.replace "publish_page_button" do %>
  <%= render LaissCms::Admin::PublishPageButton.new(page: @element.page) %>
<% end %>

<laiss-cms-growl>
  <%= LaissCms.t(:successfully_added_element) %>
</laiss-cms-growl>

<turbo-stream action="close_current_dialog"></turbo-stream>
