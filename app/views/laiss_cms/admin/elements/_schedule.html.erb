<div id="element-<%= element.id %>-schedule">
  <% if element.errors.any? %>
    <laiss-cms-message type="error" icon="warn">
      <%= LaissCms.t(:default_message, scope: "forms.error_notification") %>
    </laiss-cms-message>
  <% else %>
    <laiss-cms-message type="info">
      <% if element.public? %>
        <p><%= sanitize t(".visibility_status.public_html") %></p>
        <% if element.scheduled? && element.public_until.present? %>
          <%= sanitize t(".public_scheduled_html",
            public_until: LaissCms.l(element.public_until, format: :"laiss_cms.element_date")) %>
        <% else %>
          <%= t(".public_no_schedule") %>
        <% end %>
      <% else %>
        <p><%= sanitize t(".visibility_status.hidden_html") %></p>
        <% if element.scheduled? %>
          <% if element.public_until.present? %>
            <%= sanitize t(".hidden_window_html",
              public_on: LaissCms.l(element.public_on, format: :"laiss_cms.element_date"),
              public_until: LaissCms.l(element.public_until, format: :"laiss_cms.element_date")) %>
          <% else %>
            <%= sanitize t(".hidden_scheduled_html",
              public_on: LaissCms.l(element.public_on, format: :"laiss_cms.element_date")) %>
          <% end %>
        <% else %>
          <%= t(".hidden_no_schedule") %>
        <% end %>
      <% end %>
    </laiss-cms-message>
  <% end %>

  <%= laiss_cms_form_for [:publish, :admin, element], data: {turbo: true}, class: "full_width" do |f| %>
    <%= render "laiss_cms/admin/elements/schedule_fields", element:, form: f %>
    <div class="submit">
      <button
        type="button"
        is="laiss-cms-clear-schedule-button"
        class="secondary">
        <%= LaissCms.t(:clear_schedule) %>
      </button>
      <button type="submit">
        <%= hidden_field_tag :laiss_cms_preview_time, params[:laiss_cms_preview_time] %>
        <%= LaissCms.t(:save) %>
      </button>
    </div>
  <% end %>
</div>
