<% content_for(:toolbar) do %>
  <div class="toolbar_buttons">
    <%= render LaissCms::Admin::ToolbarButton.new(
      icon: "add",
      label: create_resource_label,
      primary: true,
      url: new_resource_path,
      hotkey: 'alt+n',
      tooltip_placement: "top-start",
      dialog_options: {
        title: create_resource_label,
        size: resource_window_size
      },
      if_permitted_to: [:create, resource_model]
    ) %>
    <%= render LaissCms::Admin::ToolbarButton.new(
      icon: :download,
      url: resource_url_proxy.url_for(action: 'index', format: 'csv', **search_filter_params),
      label: LaissCms.t(:download_csv),
      title: LaissCms.t(:download_csv),
      dialog: false,
      if_permitted_to: [:index, resource_model]
    ) %>
  </div>
  <%= render 'laiss_cms/admin/partials/search_form' %>
<% end %>

<% if resource_model.any? %>
  <%= render "laiss_cms/admin/resources/table_header", query: @query %>

  <% if resources_instance_variable.any? %>
    <div class="resources-table-wrapper">
      <%= render "resource_table", query: @query %>
    </div>
  <% elsif search_filter_params.present? %>
    <%= render_message { LaissCms.t("Nothing found") } %>
  <% end %>

  <%= render "laiss_cms/admin/resources/pagination", resources: resources_instance_variable %>
<% else %>
  <%= render "laiss_cms/admin/resources/empty_state" do %>
    <%= link_to_dialog(
      render_icon(:add) + create_resource_label,
      new_resource_path,
      {
        title: create_resource_label,
        size: resource_window_size
      },
      class: "button with_icon"
    ) %>
  <% end %>
<% end %>

<% if resource_has_tags || resource_has_filters %>
  <div id="library_sidebar">
    <%= render "filter_bar" if resource_has_filters %>
    <%= render "tag_list" if resource_has_tags %>
  </div>
<% end %>
