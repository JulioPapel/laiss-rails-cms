<% content_for :toolbar do %>
  <div class="toolbar_buttons">
    <%= render 'laiss_cms/admin/partials/site_select' %>
    <%= render LaissCms::Admin::ToolbarButton.new(
      icon: :plus,
      label: create_resource_label,
      primary: true,
      url: new_resource_path,
      hotkey: 'alt+n',
      dialog_options: {
        title: create_resource_label,
        size: "430x415"
      },
      if_permitted_to: [:create, LaissCms::Language]
    ) %>
  </div>
  <%= render 'laiss_cms/admin/partials/search_form' %>
<% end %>

<% if @languages.any? %>
  <%= render "laiss_cms/admin/resources/table_header" %>
  <div class="resources-table-wrapper">
    <%= render "table" %>
  </div>
  <%= render "laiss_cms/admin/resources/pagination", resources: @languages %>
<% elsif search_filter_params.present? %>
  <%= render_message { LaissCms.t('Nothing found') } %>
<% else %>
  <%= render "laiss_cms/admin/resources/empty_state" do %>
    <%= render "form", language: LaissCms::Language.new(
        name: LaissCms.config.default_language.name,
        code: LaissCms.config.default_language.code,
        page_layout: LaissCms.config.default_language.page_layout,
        frontpage_name: LaissCms.config.default_language.frontpage_name,
        site: LaissCms::Current.site,
        default: true,
        public: true
      )
    %>
  <% end %>
<% end %>
