<%= content_for :stylesheets do %>
  <%= stylesheet_link_tag "laiss_cms_devise" %>
<% end %>

<%= content_for :toolbar do %>
  <div class="toolbar_buttons">
    <%= render LaissCms::Admin::ToolbarButton.new(
      icon: :plus,
      label: LaissCms.t(:create_user),
      primary: true,
      url: laiss_cms.new_admin_user_path,
      hotkey: 'alt+n',
      tooltip_placement: "top-start",
      dialog_options: {
        title: LaissCms.t(:create_user),
        size: "460x190"
      },
      if_permitted_to: [:create, LaissCms::User]
    ) %>
  </div>
  <%= render "laiss_cms/admin/partials/search_form" %>
<% end %>

<div id="archive_all" class="resources-table-wrapper">
<% if @users.any? %>
  <%= render "laiss_cms/admin/resources/table_header" %>
  <%= render "resource_table", users: @users, query: @query %>
  <%= render "laiss_cms/admin/resources/pagination", resources: @users %>
<% elsif params[:query] %>

  <div class="info">
    <%= render_icon('info') %>
    <%= LaissCms.t('No users found') %>
  </div>

<% end %>
</div>
