<% if resource.errors.any? %>
  <laiss-cms-message data-turbo-temporary type="error">
    <h2>
      <%= LaissCms.t("default_message", scope: "forms.error_notification") %>
    </h2>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </laiss-cms-message>
<% end %>
