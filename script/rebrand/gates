#!/usr/bin/env bash
# Run every gate with the upstream baseline numbers baked in.
#
# A gate passes only if it exits 0 AND the example/test count matches the
# baseline. Counting matters: a broken `require` makes RSpec silently load fewer
# files, which still exits 0 with "0 failures" while testing almost nothing.
#
#   script/rebrand/gates              # run everything
#   script/rebrand/gates ruby         # only rspec + standardrb
#   script/rebrand/gates js           # only node gates
#   script/rebrand/gates rebrand      # only the rebrand tooling
set -uo pipefail

cd "$(dirname "$0")/../.." || exit 2

# Phase 10: +11 for the sidebar collapse request specs, then -11 for the update
# checker removal (5 controller, 4 service, 2 ruby_gems specs). Net: unchanged from
# the Phase 9 figure of 4408, because the two moves happened to cancel out.
# The removal is deliberate: it fetched a 404ing rubygems.org endpoint on admin
# page load, and the owner's policy is no upstream connections.
#
# beta2: 4408 -> 4410. Two regression specs for the seeder's previously silent
# behaviour: one for a missing db/seeds/laiss_cms/pages.yml, one for a file that
# exists but declares no pages. Both were confirmed to fail against the old code.
BASELINE_EXAMPLES=4410
BASELINE_DEVISE=167
# Phase 10: 851 -> 846. The update checker was removed (it fetched
# rubygems.org/api/v1/versions/laiss_cms.json, which 404s because the gem is never
# published, and it ran on admin page load). Its 5 vitest cases went with it.
# This is a deliberate feature removal, not lost coverage: every remaining test
# still runs, and the core/devise floors are unchanged because their update-check
# specs were counted in the same commit.
BASELINE_VITEST=846

failures=0
pass() { printf '  \033[32mPASS\033[0m  %s\n' "$1"; }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; failures=$((failures + 1)); }

run_ruby() {
  echo "Ruby"

  local out
  out=$(bin/rspec spec --format progress 2>&1)
  local status=$?
  local count
  count=$(echo "$out" | grep -oE '[0-9]+ examples' | tail -1 | grep -oE '[0-9]+')
  if [ "$status" -ne 0 ]; then
    fail "core specs (exit $status)"
    echo "$out" | grep -E '^rspec \./' | head -10
  elif [ "${count:-0}" -ne "$BASELINE_EXAMPLES" ]; then
    fail "core specs ran ${count:-0} examples, baseline is $BASELINE_EXAMPLES"
  else
    pass "core specs ($count examples)"
  fi

  out=$(bin/rspec devise/spec --format progress 2>&1)
  status=$?
  count=$(echo "$out" | grep -oE '[0-9]+ examples' | tail -1 | grep -oE '[0-9]+')
  if [ "$status" -ne 0 ]; then
    fail "devise specs (exit $status)"
  elif [ "${count:-0}" -ne "$BASELINE_DEVISE" ]; then
    fail "devise specs ran ${count:-0} examples, baseline is $BASELINE_DEVISE"
  else
    pass "devise specs ($count examples)"
  fi

  local lint
  if lint=$(bundle exec standardrb 2>&1); then
    pass "standardrb"
  else
    fail "standardrb"
    echo "$lint" | grep -E '^  ' | head -10
  fi
}

run_js() {
  echo "JavaScript"

  # Herb lints generated HTML too, so clear artefacts that would otherwise
  # produce offences in files nobody wrote.
  rm -rf coverage devise/coverage spec/dummy/tmp/capybara

  if pnpm run eslint > /dev/null 2>&1; then pass "eslint"; else fail "eslint"; fi
  if pnpm run lint > /dev/null 2>&1; then pass "prettier"; else fail "prettier"; fi
  if pnpm exec herb-lint > /dev/null 2>&1; then pass "herb-lint"; else fail "herb-lint"; fi

  # Documentation references. A broken README image or a dead anchor in the
  # guides is a defect a reader sees immediately, and the docs site logs dead
  # anchors per build. Cheap enough to run every time.
  local docs
  if docs=$(script/check_doc_links 2>&1); then
    pass "doc links ($(echo "$docs" | grep -oE '[0-9]+ links and images' | head -1))"
  else
    fail "doc links"
    echo "$docs" | grep -E '^  ' | head -10
  fi
  if pnpm run build > /dev/null 2>&1; then pass "build"; else fail "build"; fi

  # Vitest is flaky upstream (see docs/development/toolchain-pinning.md): it can
  # exit 1 on an unhandled rejection while every test still passes. Retry once,
  # and keep the last count we managed to parse rather than reporting a zero.
  #
  # Parsing is deliberately loose: the summary line can be interleaved with the
  # unhandled-error block, so match "Tests" then any non-digits then the count,
  # after stripping ANSI escapes.
  local out status count="" attempts=0
  for attempt in 1 2; do
    attempts=$attempt
    out=$(pnpm run test 2>&1)
    status=$?
    local seen
    seen=$(printf '%s' "$out" \
      | sed -E 's/\x1b\[[0-9;]*[a-zA-Z]//g' \
      | grep -oE 'Tests[^0-9]{0,20}[0-9]+ passed' \
      | tail -1 \
      | grep -oE '[0-9]+')
    [ -n "$seen" ] && count=$seen
    [ "$status" -eq 0 ] && break
  done

  if [ "$status" -eq 0 ]; then
    if [ -z "$count" ]; then
      # Exit 0 means vitest itself is satisfied; the count just could not be
      # read back. Warn rather than fail on an output-format detail.
      printf '  \033[33mNOTE\033[0m  vitest passed but its test count was unreadable\n'
    elif [ "$count" -ne "$BASELINE_VITEST" ]; then
      fail "vitest ran $count tests, baseline is $BASELINE_VITEST"
    else
      pass "vitest ($count tests, attempt $attempts)"
    fi
  else
    fail "vitest (exit $status after $attempts attempt(s); last parsed count ${count:-none})"
    printf '%s' "$out" | grep -E 'Unhandled Errors|TypeError|✕|FAIL ' | head -5
  fi
}

run_rebrand() {
  echo "Rebrand tooling"

  if ruby script/rebrand/self_test > /dev/null 2>&1; then
    pass "self_test"
  else
    fail "self_test"
  fi

  if ruby script/rebrand/verify > /tmp/rebrand-verify.log 2>&1; then
    pass "verify"
  else
    # The rebrand is complete, so this is a hard failure now, not a note.
    fail "verify"
    tail -10 /tmp/rebrand-verify.log
  fi

  # Raw-byte scan of every tracked file. Separate from verify on purpose: verify
  # works on in-scope text and used to mask upstream domains, which let it pass
  # while 25 files still held the upstream name.
  if ruby script/rebrand/leak_scan > /tmp/rebrand-leak.log 2>&1; then
    pass "leak_scan"
  else
    fail "leak_scan"
    tail -20 /tmp/rebrand-leak.log
  fi

  if ruby script/rebrand/leak_scan_test > /tmp/rebrand-leak-test.log 2>&1; then
    pass "leak_scan_test"
  else
    fail "leak_scan_test"
    tail -10 /tmp/rebrand-leak-test.log
  fi
}

case "${1:-all}" in
  ruby) run_ruby ;;
  js) run_js ;;
  rebrand) run_rebrand ;;
  all) run_ruby; run_js; run_rebrand ;;
  *) echo "usage: $0 [all|ruby|js|rebrand]" >&2; exit 2 ;;
esac

echo
if [ "$failures" -eq 0 ]; then
  echo "ALL GATES PASSED"
  exit 0
fi
echo "$failures GATE(S) FAILED"
exit 1
