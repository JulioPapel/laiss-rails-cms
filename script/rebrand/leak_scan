#!/usr/bin/env ruby
# frozen_string_literal: true

# Leak scan: fail if the upstream name appears anywhere outside the three
# LICENSE files.
#
# This is deliberately separate from `verify`. `verify` is a *rebranding* tool:
# it works on in-scope text files, understands mapping rows and skips generated
# output because rewriting it would be churn. That is the right behaviour for
# rewriting and the wrong behaviour for proving the rename is complete, and the
# difference hid a real defect: `verify` used to mask upstream domains before
# scanning, so it reported PASS while 25 files still carried the upstream name.
#
# This scan makes no such assumptions:
#
#   * reads RAW BYTES (no encoding assumptions, no text detection, no
#     extension filtering) — a binary with an embedded string is a leak too;
#   * scans EVERY tracked file, including build output, lockfiles and
#     vendor/ — anything that ships is in scope;
#   * the ONLY exemption is the three LICENSE files, matched exactly;
#   * nothing is masked, normalised or un-escaped before matching.
#
# Usage:
#   script/rebrand/leak_scan              # human-readable
#   script/rebrand/leak_scan --quiet      # verdict only
#   script/rebrand/leak_scan --json       # machine-readable
#
# Exits 0 when clean, 1 when anything leaks.
require "json"
require "open3"

module LeakScan
  ROOT = File.expand_path("../..", __dir__)

  # The only files allowed to contain the upstream name, exactly. No globbing:
  # an accidental fourth file must fail loudly, not slip through a pattern.
  #
  # `script/rebrand/**` is exempt because those files hold the upstream name as
  # DATA — the mapping table's `from` column, and the pattern tests. They are
  # never shipped in the gem (it packages only app/config/db/lib/vendor) and
  # never reach a consumer. This exemption is by explicit prefix and is
  # verified by self_test, not inferred.
  ALLOWED = %w[
    LICENSE
    i18n/LICENSE
    devise/LICENSE
  ].freeze

  ALLOWED_PREFIXES = %w[
    script/rebrand/
  ].freeze

  # Case-insensitive: `Alchemy`, `alchemy`, `ALCHEMY` and any casing in between
  # are all the same leak.
  PATTERN = /alchemy/i

  # ---------------------------------------------------------------------------
  # CONNECTIONS, not just names.
  #
  # The name check above catches a reintroduced identifier. It does NOT catch the
  # other half of the promise: that this software does not talk to upstream. A
  # commit could remove every mention of the name and still add an analytics
  # script, a remote feed or a badge image pointing at an upstream host, and the
  # name check would pass.
  #
  # So these patterns are checked against every tracked file too. Each entry is
  # [pattern, why], and every one of them is a real thing that was found in this
  # repository or its inherited guides:
  #
  #   * the guides shipped an analytics script from the upstream host
  #   * the guides shipped ad components linking to it
  #   * an update checker built a request to a gems service
  #   * a gemspec pointed its homepage at the upstream site
  #
  # A host is matched by DOMAIN, not by substring, so a legitimate host that
  # merely contains the word cannot trip it.
  # ---------------------------------------------------------------------------
  CONNECTION_PATTERNS = [
    # Upstream web properties. These existed as analytics, ads and doc links.
    [/\balchemy-cms\.(com|org|net|io)\b/i, "upstream website"],
    [/\bguides\.alchemy-cms\.com\b/i, "upstream documentation host"],
    [/\b(alchemy-cms|alchemycms)\.slack\.com\b/i, "upstream Slack"],
    [/\bgithub\.com\/alchemycms\b/i, "upstream GitHub organisation"],
    [/\bdocs\.alchemy-cms\.com\b/i, "upstream docs host"],

    # Upstream package identifiers. Distinct from the display name, so they catch
    # a dependency or an install line that the name check would miss.
    [/\bgem\s+["']alchemy_cms["']/i, "upstream gem dependency"],
    [/\balchemy_cms\b/i, "upstream gem name"],
    [/\balchemy-cms-devise\b/i, "upstream gem name (devise)"],
    [/\balchemy_i18n\b/i, "upstream i18n gem"],

    # Outbound calls. Anything that fetches at page-load time is a connection
    # even when the host is not upstream, so these are listed to force a
    # deliberate decision rather than an accidental one.
    [/<script[^>]+src\s*=\s*["']https?:\/\//i, "remote script in a template"],
    [/@import\s+url\(\s*["']?https?:\/\//i, "remote stylesheet import"],
    [/Net::HTTP\.(get|post|start)\b/, "outbound HTTP from Ruby"],
    [/\bFaraday\.(get|post|new|connection)\b/, "outbound HTTP via Faraday"],
    [/\bRestClient\.(get|post)\b/, "outbound HTTP via RestClient"],
    [/\bHTTParty\.(get|post)\b/, "outbound HTTP via HTTParty"],
    [/\bURI\.open\(\s*["']https?:\/\//, "outbound HTTP via URI.open"],
    [/\bopen\(\s*["']https?:\/\//, "outbound HTTP via Kernel#open"]
  ].freeze

  class << self
    # Every file that ships. `git ls-files` rather than a filesystem walk, so
    # untracked scratch files do not create false failures and gitignored build
    # output that *is* committed is still scanned.
    def tracked_files
      out, status = Open3.capture2("git", "-C", ROOT, "ls-files", "-z")
      raise "git ls-files failed" unless status.success?

      out.split("\0").reject(&:empty?)
    end

    def scan
      findings = []

      tracked_files.each do |path|
        next if ALLOWED.include?(path)
        next if ALLOWED_PREFIXES.any? { |prefix| path.start_with?(prefix) }

        absolute = File.join(ROOT, path)
        next unless File.file?(absolute)

        begin
          bytes = File.binread(absolute)
        rescue SystemCallError => e
          findings << {path: path, line: nil, context: "unreadable: #{e.message}"}
          next
        end

        # Name leaks. Report line numbers where the file is line-oriented;
        # otherwise point at the first byte offset so binary hits are actionable.
        findings.concat(collect_hits(path, bytes)) if bytes.match?(PATTERN)

        # Connection leaks. These are independent of the name check: a file can
        # contain no upstream name at all and still open a socket to it.
        findings.concat(collect_connection_hits(path, bytes))
      end

      findings
    end

    # Report domains, package identifiers and outbound-call primitives.
    #
    # Line-oriented like collect_hits, but every CONNECTION_PATTERN is tried
    # against every line rather than short-circuiting on the first match, so one
    # line with two problems reports both.
    def collect_connection_hits(path, bytes)
      return [] if bytes.include?("\x00") # binary: already covered by the name scan

      hits = []
      bytes.each_line.with_index(1) do |raw, lineno|
        line = raw.force_encoding("UTF-8").scrub
        stripped = line.sub(/\A\s+/, "")

        # A commented-out example is documentation, not behaviour. This matters
        # for the outbound-call patterns: `publish_targets` documents how a HOST
        # APP might POST to its own build hook, which is the app's request, not
        # ours. Remote script/style tags are still checked inside comments,
        # because a commented-out CDN script is one uncomment away from shipping.
        commented = stripped.start_with?("#", "//", "*", "<!--")

        CONNECTION_PATTERNS.each do |pattern, why|
          next if commented && why.start_with?("outbound HTTP")
          next unless line.match?(pattern)

          hits << {
            path: path,
            line: lineno,
            context: "#{why}: #{line.strip[0, 120]}"
          }
        end
      end
      hits
    end

    def collect_hits(path, bytes)
      text = bytes.dup.force_encoding(Encoding::UTF_8)

      if text.valid_encoding?
        text.each_line.with_index(1).filter_map do |line, number|
          next unless line.match?(PATTERN)

          {path: path, line: number, context: line.strip[0, 120]}
        end
      else
        # Binary: report the offset of each occurrence.
        offsets = []
        start = 0
        while (index = bytes.index(PATTERN, start))
          offsets << index
          start = index + 1
          break if offsets.size >= 5
        end
        offsets.map { |o| {path: path, line: nil, context: "binary, byte offset #{o}"} }
      end
    end
  end
end

def main(argv)
  quiet = argv.include?("--quiet")
  json = argv.include?("--json")
  unknown = argv - %w[--quiet --json]
  unless unknown.empty?
    warn "unknown option(s): #{unknown.join(" ")}"
    return 2
  end

  findings = LeakScan.scan

  if json
    puts JSON.pretty_generate({
      allowed: LeakScan::ALLOWED,
      scanned: LeakScan.tracked_files.size,
      findings: findings
    })
    return findings.empty? ? 0 : 1
  end

  if findings.empty?
    unless quiet
      puts "OK    upstream name absent from all #{LeakScan.tracked_files.size} tracked files " \
        "(exempt: #{LeakScan::ALLOWED.join(", ")})"
    end
    puts "VERDICT: PASS"
    return 0
  end

  unless quiet
    puts "FAIL — upstream name found outside the licence allowlist:"
    findings.group_by { |f| f[:path] }.each do |path, hits|
      puts
      puts "  #{path} (#{hits.size} occurrence#{"s" unless hits.size == 1})"
      hits.first(5).each do |hit|
        location = hit[:line] ? ":#{hit[:line]}" : ""
        puts "    #{path}#{location}: #{hit[:context]}"
      end
      puts "    ... #{hits.size - 5} more" if hits.size > 5
    end
    puts
  end

  puts "VERDICT: FAIL (#{findings.size} occurrence(s) in " \
    "#{findings.map { |f| f[:path] }.uniq.size} file(s))"
  1
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
