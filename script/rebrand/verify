#!/usr/bin/env ruby
# frozen_string_literal: true

# Guard: fail the build if the rebrand is incomplete or inconsistent.
#
# Two independent checks, reported separately:
#
#   1. LEFTOVERS — any upstream token still present outside the three LICENSE
#      allowlist files. This is the "you missed a spot" check.
#
#   2. DRIFT — the replacement tokens appear in a casing or separator form the
#      naming policy does not allow (e.g. `laisscms` for `LaissCMS`, or
#      `laiss_cms::` where a namespace `LaissCms::` was meant). This catches the
#      damage a careless bulk replace does, which a leftover check would miss
#      because the upstream name is already gone.
#
# Exits 1 if anything is wrong, 0 when the tree is clean.
#
#   script/rebrand/verify
#   script/rebrand/verify --quiet     # only the verdict line
require_relative "lib"
require_relative "rename_paths"

# Forms that must never appear. Each entry is [pattern, why, expected].
#
# Deliberately narrow: `laiss_cms.foo_path` is CORRECT, not drift — Rails route
# helpers are prefixed with the engine's snake_case name (upstream:
# `alchemy.admin_element_path`), so a bare `laiss_cms.` must not be flagged.
DRIFT_RULES = [
  [/\blaisscms\b/, "all-lowercase squashing", "LaissCMS or laiss_cms"],
  [/\blasscms\b/, "missing i", "LaissCMS"],
  [/\blaiss_cms::/, "snake_case used as a constant", "LaissCms::"],
  [/\bLaissCms_[A-Z]/, "constant written with a trailing underscore", "LaissCms"],
  [/\blaissCms\b/, "mixed case", "LaissCMS or laiss_cms"],
  [/\bLaisscms\b/, "wrong internal capitalisation", "LaissCMS"],
  [/\bLAISS_CMS::/, "env-style prefix used as a Ruby constant", "LaissCms::"],
  [/\blaiss-cms_/, "kebab prefix with snake separator", "laiss-cms- or laiss_cms_"],
  [/\blaiss_cms-/, "snake prefix with kebab separator", "laiss_cms_ or laiss-cms-"],
  [/\bLAISS-CMS_/, "hyphenated env prefix", "LAISS_CMS_"],
  [/\bLaissCMS_/, "brand name used as a prefix", "LaissCms (no underscore)"]
].freeze

# Upstream branding that must not survive: asset filenames, the palette colours
# those assets used, and the font family upstream shipped.
UPSTREAM_ASSET_NAMES = %w[
  alchemy-logo.svg
  alchemy-logo.png
  alchemy_admin.min.js
  alchemy-devise.css
].freeze

# Colours from upstream's artwork and UI palette. #eca96e was the admin logo,
# the rest were its chrome. Checked case-insensitively as hex without the hash
# so both `#2d5a8d` and `2d5a8d` are caught.
UPSTREAM_COLOURS = %w[eca96e 2d5a8d 214166 4099ff cc8500 efd3d3 222f3e].freeze

# Font families upstream shipped. "Lato" is checked as a font reference only, so
# identifiers like `accumulator` do not match.
UPSTREAM_FONTS = /font-family:\s*["']?Lato|"Lato"|'Lato'/i

def brand_violations
  hits = []

  # 1. any file still named after an upstream asset
  Dir.glob("**/*", base: Rebrand::ROOT).each do |path|
    next if path.start_with?(".git/", "node_modules/")
    next unless File.file?(File.join(Rebrand::ROOT, path))

    base = File.basename(path)
    hits << "asset: #{path}" if UPSTREAM_ASSET_NAMES.include?(base)
  end

  # 2. upstream palette colours in stylesheets, views, JS and build output
  colour_pattern = /(?:#{UPSTREAM_COLOURS.join("|")})/i
  Rebrand.tracked_files.each do |path|
    next unless path.match?(/\.(scss|sass|css|erb|rb|js|svg)\z/)
    next if path.start_with?("script/")

    Rebrand.read(path).each_line.with_index(1) do |line, number|
      next unless line.match?(colour_pattern)
      # Only flag hex literals, not incidental runs of digits in other content.
      next unless line.match?(/#(?:#{UPSTREAM_COLOURS.join("|")})\b/i)

      hits << "palette: #{path}:#{number}: #{line.strip[0, 100]}"
    end
  end

  # 3. upstream font family references
  Rebrand.tracked_files.each do |path|
    next unless path.match?(/\.(scss|sass|css|erb|rb|svg|js)\z/)
    next if path.start_with?("script/")

    Rebrand.read(path).each_line.with_index(1) do |line, number|
      hits << "font: #{path}:#{number}: #{line.strip[0, 100]}" if line.match?(UPSTREAM_FONTS)
    end
  end

  hits
end

def main(argv)
  quiet = argv.include?("--quiet")
  unknown = argv - %w[--quiet]
  unless unknown.empty?
    warn "unknown option(s): #{unknown.join(" ")}"
    return 2
  end

  problems = 0

  # --- check 1: leftovers ---------------------------------------------------
  # Protected upstream domains are masked first: they legitimately contain the
  # upstream token and are deliberately left verbatim (see Rebrand::PROTECTED).
  tally = Rebrand.tally(Rebrand.tracked_files.to_h { |path| [path, Rebrand.mask_protected(Rebrand.read(path))] })
  leftovers = tally.reject { |_, entry| entry[:count].zero? }

  if leftovers.any?
    puts "FAIL — upstream tokens remain outside the licence allowlist:"
    leftovers.each do |id, entry|
      row = Rebrand.row_by_id(id)
      printf("\n  [%s] %s -> %s: %d occurrence(s) in %d file(s)\n",
        id, row.from, row.to, entry[:count], entry[:files].size)
      entry[:files].first(5).each { |path| puts "    #{path}" }
    end
    puts
    problems += leftovers.size
  elsif !quiet
    puts "OK    no upstream tokens remain (allowlisted: #{Rebrand::LICENSE_ALLOWLIST.join(", ")})"
  end

  # --- check 2: drift -------------------------------------------------------
  files = Rebrand.tracked_files
  drift_hits = []

  files.each do |path|
    content = Rebrand.read(path)
    DRIFT_RULES.each do |pattern, why, expected|
      content.each_line.with_index(1) do |line, number|
        next unless line.match?(pattern)

        drift_hits << "#{path}:#{number}: #{why} — expected #{expected}: #{line.strip[0, 110]}"
      end
    end
  end

  if drift_hits.any?
    puts "FAIL — case/separator drift in replacement tokens:"
    drift_hits.first(25).each { |hit| puts "    #{hit}" }
    puts "    ... #{drift_hits.size - 25} more" if drift_hits.size > 25
    puts
    problems += drift_hits.size
  elsif !quiet
    puts "OK    no case/separator drift in replacement tokens (#{DRIFT_RULES.size} rules)"
  end

  # --- check 3: path segments still carrying upstream tokens ----------------
  # Content checks cannot see these: a migration filename's token sits after a
  # timestamp underscore, which the identifier rules deliberately ignore.
  stale_paths = RenamePaths.plan

  if stale_paths.any?
    puts "FAIL — paths still carry upstream tokens:"
    stale_paths.first(20).each do |entry|
      from = entry[:from] || entry[:sources]
      to = entry[:to] || entry[:target]
      puts "    #{entry[:type]}: #{from} -> #{to}"
    end
    puts "    ... #{stale_paths.size - 20} more" if stale_paths.size > 20
    puts
    problems += stale_paths.size
  elsif !quiet
    puts "OK    no path names carry upstream tokens"
  end

  # --- check 4: brand assets and palette -----------------------------------
  # Upstream artwork and its palette must not survive the rebrand. These are
  # separate from the token checks above because the filename check looks at
  # *files*, and the colour check looks at values rather than names.
  brand_hits = brand_violations
  if brand_hits.any?
    puts "FAIL — upstream branding survives:"
    brand_hits.first(25).each { |hit| puts "    #{hit}" }
    puts "    ... #{brand_hits.size - 25} more" if brand_hits.size > 25
    puts
    problems += brand_hits.size
  elsif !quiet
    puts "OK    no upstream artwork, palette or font references"
  end

  # --- check 5: allowlist is intact ----------------------------------------
  missing = Rebrand::LICENSE_ALLOWLIST.reject { |path| File.exist?(File.join(Rebrand::ROOT, path)) }
  if missing.any?
    puts "FAIL — allowlisted licence file(s) missing: #{missing.join(", ")}"
    problems += missing.size
  end

  if problems.zero?
    puts "VERDICT: PASS"
    0
  else
    puts "VERDICT: FAIL (#{problems} problem(s))"
    1
  end
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
