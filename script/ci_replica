#!/usr/bin/env bash
# Replicates .github/workflows/ci.yml locally, verifying that each job's steps run
# — including the fact that every job delegates to script/gates.
#
# Since ci.yml now calls script/gates, this script is deliberately thin: it
# reproduces the per-job environment and the action steps it can, then invokes the
# same gate subset the workflow does. If the two ever diverge, this is where it
# shows.
#
#   script/ci_replica ruby
#   script/ci_replica javascript
#   script/ci_replica leak-scan
#   script/ci_replica scratch
set -uo pipefail

JOB="${1:-}"
cd "$(dirname "$0")/.." || exit 2

pass() { printf '  \033[32mPASS\033[0m  %s\n' "$1"; }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; FAILS=$((FAILS + 1)); }
skip() { printf '  \033[33mSKIP\033[0m  %s\n' "$1"; }
FAILS=0

# Each job in ci.yml runs these action steps first. They cannot be reproduced here,
# so they are named rather than silently omitted.
declare_skipped_actions() {
  skip "actions/checkout@v4 (already on a working tree)"
  skip "ruby/setup-ruby@v1 ruby-version ${1:-4.0.6} (running $(ruby -v | cut -d' ' -f2))"
  skip "pnpm/action-setup@v4 + actions/setup-node@v4 (node $(node --version), pnpm $(pnpm --version))"
}

job_ruby() {
  echo "job: ruby — matrix leg ruby ${RUBY_LEG:-4.0.6} / rails ${RAILS_LEG:-8.1}"
  declare_skipped_actions "${RUBY_LEG:-4.0.6}"

  # "Dependencies and assets", verbatim.
  if pnpm install --frozen-lockfile > /tmp/ci-replica-step.log 2>&1; then
    pass "pnpm install --frozen-lockfile"
  else
    fail "pnpm install --frozen-lockfile"; tail -5 /tmp/ci-replica-step.log
  fi
  if bundle install > /tmp/ci-replica-step.log 2>&1; then
    pass "bundle install"
  else
    fail "bundle install"; tail -5 /tmp/ci-replica-step.log
  fi
  if pnpm run build > /tmp/ci-replica-step.log 2>&1; then
    pass "pnpm run build"
  else
    fail "pnpm run build"; tail -5 /tmp/ci-replica-step.log
  fi

  # "Gates (ruby)" — the workflow's actual command.
  echo "  -> script/gates ruby"
  if RAILS_ENV=test RAILS_VERSION="${RAILS_LEG:-8.1}" script/gates ruby; then
    pass "script/gates ruby"
  else
    fail "script/gates ruby"
  fi
}

job_javascript() {
  echo "job: javascript"
  declare_skipped_actions
  echo "  -> script/gates js"
  if script/gates js; then pass "script/gates js"; else fail "script/gates js"; fi
}

job_leak_scan() {
  echo "job: leak-scan (Rebrand guard)"
  declare_skipped_actions
  echo "  -> script/gates rebrand"
  if script/gates rebrand; then pass "script/gates rebrand"; else fail "script/gates rebrand"; fi
}

job_scratch() {
  echo "job: scratch (Scratch app)"
  declare_skipped_actions
  echo "  -> script/gates scratch"
  if script/gates scratch; then pass "script/gates scratch"; else fail "script/gates scratch"; fi
}

case "$JOB" in
  ruby)       job_ruby ;;
  javascript) job_javascript ;;
  leak-scan)  job_leak_scan ;;
  scratch)    job_scratch ;;
  *) echo "usage: $0 [ruby|javascript|leak-scan|scratch]" >&2; exit 2 ;;
esac

echo
if [ "$FAILS" -eq 0 ]; then echo "JOB PASSED"; exit 0; fi
echo "$FAILS STEP(S) FAILED"; exit 1
